# Usar imagem oficial do Nginx
FROM nginx:alpine

# Instalar curl para healthcheck
RUN apk add --no-cache curl

RUN rm /etc/nginx/conf.d/default.conf

# Copiar arquivos estáticos do Spring Boot
COPY src/main/resources/static /usr/share/nginx/html

# Garantir que diretórios existem
RUN mkdir -p /usr/share/nginx/html/images
RUN mkdir -p /usr/share/nginx/html/uploads

# Se não houver placeholder, criar um básico
RUN if [ ! -f /usr/share/nginx/html/images/placeholder.jpg ]; then \
        echo "Creating basic placeholder..." && \
        echo "<svg width='300' height='300' xmlns='http://www.w3.org/2000/svg'><rect width='100%' height='100%' fill='#f5f5f5' stroke='#ddd' stroke-width='2'/><text x='50%' y='50%' font-family='Arial' font-size='16' fill='#999' text-anchor='middle'>Sem Imagem</text></svg>" > /usr/share/nginx/html/images/placeholder.svg; \
    fi

# Copiar configuração personalizada do Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expor porta 80
EXPOSE 80

# Comando para iniciar o Nginx
CMD ["nginx", "-g", "daemon off;"]